# Apogee LibreChat Production Dockerfile
# Extends official LibreChat image with Apogee configuration
#
# VERSION PINNING STRATEGY:
# - Pin to specific version to prevent patches from breaking
# - Before updating: rebuild locally, test all patches, run E2E tests
# - Patches that may break on update:
#   - apogee-server/apogeeAuth.js (SSO auth)
#   - apogee-server/patch-auth.js (auth modifications)
#   - apogee-server/promptCounter.js (prompt tracking)
#   - apogee-server/anonymousIndicator.js (UI injection)
#
# Last tested: 2026-02-03 with v0.8.2-rc3

FROM ghcr.io/danny-avila/librechat:v0.8.2-rc3

# Copy Apogee configuration
COPY config/apogee/librechat.yaml /app/librechat.yaml

# Copy branding assets
COPY config/apogee/branding/ /app/client/public/images/branding/

# Copy custom Apogee SSO server files
COPY config/apogee/server/ /app/apogee-server/

# Download RDS CA bundle for DocumentDB TLS and install jose for JWT verification
USER root
RUN wget -q https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
    -O /app/rds-combined-ca-bundle.pem && \
    chown node:node /app/rds-combined-ca-bundle.pem && \
    chown -R node:node /app/apogee-server

# Install jose for JWT verification in the apogee-server directory
WORKDIR /app/apogee-server
RUN npm init -y && npm install jose

WORKDIR /app

# Copy and set up entrypoint script
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && chown node:node /app/entrypoint.sh
USER node

# Environment defaults
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3080

EXPOSE 3080

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["npm", "run", "backend"]
