# Apogee LibreChat Environment Template
# Copy to .env and fill in values

#=============================================================================
# Core Settings
#=============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=3080
NODE_ENV=production

# Domain (for CORS, cookies, etc.)
DOMAIN_CLIENT=https://chat.apog.ai
DOMAIN_SERVER=https://chat.apog.ai

#=============================================================================
# Database
#=============================================================================

# MongoDB/DocumentDB connection
MONGO_URI=mongodb://localhost:27017/librechat

#=============================================================================
# AWS Bedrock
#=============================================================================

BEDROCK_AWS_DEFAULT_REGION=us-east-1
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=

# Or use IAM role (preferred for production)
# Leave access key/secret empty and ensure ECS task role has Bedrock permissions

#=============================================================================
# MCP Gateway
#=============================================================================

# Apogee MCP Gateway endpoint
MCP_GATEWAY_URL=https://mcp.apog.ai

# API key for authenticated MCP requests (user's Apogee API key)
# MCP_API_KEY=apk_...

#=============================================================================
# Authentication
#=============================================================================

# JWT secret for session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=

# Refresh token secret (generate with: openssl rand -hex 32)
JWT_REFRESH_SECRET=

# Session expiry (milliseconds) - default 24 hours
SESSION_EXPIRY=86400000

# Refresh token expiry (milliseconds) - default 7 days
REFRESH_TOKEN_EXPIRY=604800000

# Allow public registration
ALLOW_REGISTRATION=true

# Allow email/password login
ALLOW_EMAIL_LOGIN=true

# Require email verification
EMAIL_VERIFICATION=false

#=============================================================================
# Apogee SSO (Dashboard → Chat)
#=============================================================================

# RSA Public Key for verifying JWTs from Apogee Dashboard
# Generate with: scripts/generate-sso-keys.sh in apogee-platform repo
# Format: PEM with \n for newlines
APOGEE_JWT_PUBLIC_KEY=

#=============================================================================
# SSO (Optional - for enterprise)
#=============================================================================

# OpenID Connect provider (Azure AD, Okta, Cognito)
# OPENID_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# OPENID_CLIENT_ID=
# OPENID_CLIENT_SECRET=
# OPENID_SCOPE=openid profile email
# OPENID_CALLBACK_URL=https://chat.apog.ai/oauth/openid/callback

#=============================================================================
# Branding
#=============================================================================

APP_TITLE=Apogee AI
CUSTOM_FOOTER=Powered by Apogee Intelligence

#=============================================================================
# Search (Optional)
#=============================================================================

# Meilisearch for conversation search
# MEILI_HOST=http://meilisearch:7700
# MEILI_MASTER_KEY=
